<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.start.translation</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/screen-translator/start.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/user/screen-translator</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/screen-translator.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/screen-translator.error.log</string>
</dict>
</plist>
